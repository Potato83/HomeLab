BOT_TOKEN=
# Comma-separated admin/allowed Telegram user IDs. Empty/invalid list prevents startup.
ALLOWED_USER_IDS=123456789
# Optional subset of the whitelist; empty means all allowed users.
DAILY_REPORT_IDS=
# Optional Telegram proxy; HTTP health checks connect directly.
VPN=socks5://127.0.0.1:2080
# Optional authentication header value for a configured service.
# PORTAINER_API_KEY=
# Monitoring thresholds, process checks, network, logs and digest use config.toml.
