#!/sbin/openrc-run
supervisor="supervise-daemon"
command="${uv_path:-/usr/bin/uv}"
command_args="run --locked --no-sync --no-dev bot"
command_user="chatbot:chatbot"
directory="/srv/bots/chatbot"
respawn_delay=10
respawn_max=10
respawn_period=300
retry="TERM/30/KILL/5"
supervise_daemon_args="--env PYTHONUNBUFFERED=1 --env PYTHONDONTWRITEBYTECODE=1 --env UV_NO_CACHE=1 --env UV_PYTHON=/usr/bin/python3 --env UV_PYTHON_DOWNLOADS=never"
output_log="/var/log/chatbot/chatbot.log"
error_log="/var/log/chatbot/chatbot-error.log"
depend() {
    need net
    after nftables sing-box
}
