#!/sbin/openrc-run
description="chatbot Telegram bot (Podman)"

depend() {
    need net
    after local nftables sing-box
}

start() {
    ebegin "Starting chatbot"
    if [ "$(/usr/bin/podman inspect --format '{{.State.Running}}' chatbot 2>/dev/null)" = "true" ]; then
        eend 0
    else
        /usr/bin/podman start chatbot
        eend $?
    fi
}

stop() {
    ebegin "Stopping chatbot"
    /usr/bin/podman stop --time 90 chatbot
    eend $?
}

status() {
    if [ "$(/usr/bin/podman inspect --format '{{.State.Running}}' chatbot 2>/dev/null)" = "true" ]; then
        einfo "chatbot is running"
    else
        eerror "chatbot is stopped"
        return 1
    fi
}
