BOT_TOKEN=
OWNER_ID=
# Optional Telegram proxy. Keep authenticated proxy URLs private.
PROXY_URL=
# Loopback SSH forward or HTTPS endpoint; never expose an unauthenticated server.
OPENCODE_URL=http://127.0.0.1:4096
# Optional fixed argv transport; exchanges JSON on stdin/stdout. Password not needed in this mode.
OPENCODE_COMMAND=
OPENCODE_SERVER_PASSWORD=
# Absolute directory on the OpenCode host, not on the laptop. Set after inspecting harness.
OPENCODE_DIRECTORY=
# Optional configured agent; no CTF prompts belong here.
OPENCODE_AGENT=
STATE_FILE=data/agentbot.sqlite3
POLL_SECONDS=5
