# Создайте бота через @BotFather. Токен храните только у себя.
TELEGRAM_BOT_TOKEN=
# Ваш личный chat_id; получить: python -m botwork chat-id
TELEGRAM_CHAT_ID=
BOTWORK_CONFIG=config.toml
BOTWORK_DB=data/botwork.sqlite3
# Для включения источника hh.ru: токен API из зарегистрированного приложения.
HH_API_TOKEN=
# Необязательно: исходный JSON-каталог /sites. Изменения из Telegram хранятся в BOTWORK_DB.
# BOTWORK_SITES=/app/sites.json

# После настройки: python -m botwork doctor --online
# Отправить одно тестовое сообщение: python -m botwork test-telegram
