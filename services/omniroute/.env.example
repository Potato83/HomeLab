# Generate distinct random secrets on the chosen deployment host.
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
INITIAL_PASSWORD=
REQUIRE_API_KEY=true
ALLOW_API_KEY_REVEAL=false
# Local HTTP only; enable secure cookies once a TLS endpoint is configured.
AUTH_COOKIE_SECURE=false
# Keep this much free space before storing detailed request artifacts.
CALL_LOG_MIN_FREE_DISK_MB=8192
